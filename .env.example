# Copy this file to .env and replace every placeholder before running Docker Compose.
# Never commit your real .env file.

ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=DERMASATHIAI
API_V1_STR=/api/v1

# PostgreSQL container credentials. Use a strong, unique password.
POSTGRES_DB=dermasathi
POSTGRES_USER=dermasathi
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://dermasathi:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/dermasathi

# Generate a unique signing secret; do not reuse the development default.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# AI credentials remain server-side only.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=0
AI_MAX_GEMINI_MODELS_PER_REQUEST=2
AI_MAX_OUTPUT_TOKENS=6144
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Browser-visible frontend API URL. For cloud deployments use your HTTPS API origin.
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5174
MAX_UPLOAD_SIZE_BYTES=10485760
